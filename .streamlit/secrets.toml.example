# Plantilla — copia esto como Secret File en Render con la ruta ".streamlit/secrets.toml"
# y rellena los valores reales. NUNCA subas el secrets.toml real a git.

[auth]
# URL pública de tu app en Render + "/oauth2callback" (o "http://localhost:8501/oauth2callback" en local)
redirect_uri = "https://TU-APP.onrender.com/oauth2callback"
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "GENERA_UNA_CADENA_ALEATORIA"

[auth.google]
client_id = "TU_CLIENT_ID.apps.googleusercontent.com"
client_secret = "TU_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
